{
  "name": "@ehildt/ckir-bullmq",
  "version": "0.1.3",
  "description": "A TypeScript wrapper library for bullmq",
  "license": "MIT",
  "author": {
    "name": "Eugen Hildt",
    "email": "eugen.hildt@gmail.com"
  },
  "main": "dist/index.js",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehildt/ckir.io.git"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "publish:lib": "pnpm build:lib && pnpm publish --access public",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:lib:prod": "tsc -p tsconfig.build.prod.json",
    "prebuild": "rimraf dist",
    "lint": "eslint './src/**/*.ts'",
    "format": "prettier --write .",
    "depcheck": "npx depcheck .",
    "ncu:update": "npx npm-check-updates -u --format group",
    "ncu:interactive": "npx npm-check-updates -u --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:clearCache": "jest --clearCache",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@nestjs/testing": "^11.1.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.4.0",
    "ioredis": "^5.8.2",
    "jest": "^30.2.0",
    "jest-extended": "^6.0.0",
    "jest-junit": "^16.0.0",
    "joi": "^18.0.1",
    "npm-check-updates": "^18.3.1",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "packageManager": "pnpm@10.19.0",
  "peerDependencies": {
    "@ehildt/ckir-helpers": "^0.1.8",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "bullmq": "^5.58.9",
    "ioredis": "^5.8.0",
    "joi": "^18.0.1",
    "pino": "^9.12.0"
  }
}
