  msg-gateway:
    container_name: msg-gateway
    restart: on-failure
    build:
      context: ./apps/msg-gateway
      target: local
    volumes:
      - ./apps/msg-gateway:/app
      - ./node_modules:/node_modules  
    depends_on:
      - keydb
    env_file:
      - ./apps/msg-gateway/.env
    environment:
      - NODE_ENV=local
      - PRINT_CONFIG=true
      - ENABLE_SWAGGER=true
      - ENABLE_REST=true
    ports:
      - 3001:3001
      - 8081:8081
    networks:
      - re-sync-network