{
  "name": "@ckir.io/topics",
  "description": "A microservice that emits topics",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "email": "eugen.hildt@gmail.com",
    "name": "Eugen Hildt"
  },
  "bugs": {
    "email": "eugen.hildt@gmail.com"
  },
  "scripts": {
    "build": "nest build --path ./tsconfig.build.json",
    "build:prod": "nest build --path ./tsconfig.build.prod.json",
    "depcheck": "npx depcheck .",
    "depcruise": "npx depcruise -c .depcruise.mjs --ts-config tsconfig.json src",
    "format": "prettier --write .",
    "lint": "eslint ./src",
    "lint-staged": "npx lint-staged --allow-empty",
    "ncu:update": "npx npm-check-updates -u --format group",
    "ncu:interactive": "npx npm-check-updates -u --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:debug": "nest start --debug --watch  --preserveWatchOutput",
    "start:dev": "dotenv -e .env -- nest start --watch  --preserveWatchOutput",
    "start:node": "node dist/main",
    "test": "jest --passWithNoTests",
    "test:clearCache": "jest --clearCache",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch",
    "lint:unused": "npx ts-unused-exports ./tsconfig.exclude.json --maxIssues=0"
  },
  "dependencies": {
    "@ckir.io/dtos": "file:../../libs/dtos",
    "@ckir.io/socket-io": "file:../../libs/socket-io",
    "@ckir.io/bullmq": "file:../../libs/bullmq",
    "@eslint/js": "^9.36.0",
    "@fastify/compress": "^8.1.0",
    "@fastify/static": "^8.2.0",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "bullmq": "^5.58.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.8.0",
    "joi": "^18.0.1",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typescript-eslint": "^8.44.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^17.0.1",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.4.0",
    "jest": "^30.1.3",
    "jest-extended": "^6.0.0",
    "jest-junit": "^16.0.0",
    "jiti": "^2.6.0",
    "lint-staged": "^16.2.0",
    "npm-check-updates": "^18.3.0",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "ts-unused-exports": "^11.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.17.1"
}