{
  "name": "@re-sync/chat",
  "description": "A chat microservice",
  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "email": "eugen.hildt@gmail.com",
    "name": "Eugen Hildt"
  },
  "bugs": {
    "email": "eugen.hildt@gmail.com"
  },
  "scripts": {
    "build": "nest build --path ./tsconfig.build.json",
    "build:prod": "nest build --path ./tsconfig.build.prod.json",
    "depcheck": "npx depcheck .",
    "depcruiser": "npx depcruise -c .depcruiser.mjs --ts-config tsconfig.json src",
    "format": "prettier --write .",
    "lint": "eslint ./src",
    "lint-staged": "npx lint-staged --allow-empty",
    "ncu:update": "npx npm-check-updates --interactive --format group",
    "ncu:validate": "npx npm-check-updates -e 2 --packageFile=./package.json",
    "prebuild": "rimraf dist",
    "start": "nest start",
    "start:debug": "nest start --debug --watch  --preserveWatchOutput",
    "start:dev": "dotenv -e .env -- nest start --watch  --preserveWatchOutput",
    "start:node": "node dist/main",
    "test": "jest --passWithNoTests",
    "test:clearCache": "jest --clearCache",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:watch": "jest --watch",
    "ts-unused-exports": "npx ts-unused-exports ./tsconfig.exclude.json --maxIssues=20"
  },
  "dependencies": {
    "@eslint/js": "^9.22.0",
    "@fastify/compress": "^8.0.1",
    "@fastify/static": "^8.1.1",
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/cache-manager": "^3.0.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/microservices": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@nestjs/platform-socket.io": "^11.0.11",
    "@nestjs/swagger": "^11.0.6",
    "@nestjs/websockets": "^11.0.11",
    "@paralleldrive/cuid2": "^2.2.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.5",
    "bullmq": "^5.43.0",
    "cache-manager": "^6.4.1",
    "cache-manager-ioredis": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.6.0",
    "joi": "^17.13.3",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typescript-eslint": "^8.26.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.11",
    "@types/cache-manager-ioredis": "^2.0.7",
    "@types/eslint": "^9.6.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "depcheck": "^1.4.7",
    "dependency-cruiser": "^16.10.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.5.0",
    "npm-check-updates": "^17.1.15",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-unused-exports": "^11.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.6.3"
}
